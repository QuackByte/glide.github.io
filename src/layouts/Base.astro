---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { href, asset, messages, langs, languages, defaultLang, type Lang, type Route } from '../i18n';

interface Props {
  lang: Lang;
  route: Route;
  title: string;
  description: string;
}

const { lang, route, title, description } = Astro.props;
const site = Astro.site ?? new URL('https://quackbyte.dev');
const canonical = new URL(href(route, lang), site).href;
const alt = (l: Lang) => new URL(href(route, l), site).href;
---
<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={languages[l].htmlLang} href={alt(l)} />)}
    <link rel="alternate" hreflang="x-default" href={alt(defaultLang)} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={languages[l].ogLocale} />)}
    <meta name="color-scheme" content="light" />
  </head>
  <body>
    <a class="skip" href="#main">{messages[lang].site.skip}</a>
    <Header lang={lang} route={route} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
