---
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';
import { policiesUpdated } from '../config';
import { formatDate, messages, filler, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = messages[lang].privacy;
const fill = filler(lang, { date: formatDate(policiesUpdated, lang) });
---
<Base lang={lang} route="privacy" title={t.title} description={t.description}>
  <Prose title={t.heading} updated={fill(t.updated)} intro={t.intro}>
    <h2>{t.responsible.title}</h2>
    <p set:html={fill(t.responsible.bodyHtml)} />

    <h2>{t.apps.title}</h2>
    <h3>{t.apps.stores.title}</h3>
    <p set:html={fill(t.apps.stores.bodyHtml)} />
    <h3>{t.apps.updates.title}</h3>
    <p set:html={fill(t.apps.updates.bodyHtml)} />
    <h3>{t.apps.doesNot.title}</h3>
    <ul>
      {t.apps.doesNot.items.map((item) => <li>{item}</li>)}
    </ul>
    <h3>{t.apps.permissions.title}</h3>
    <p>{t.apps.permissions.body}</p>

    <h2>{t.website.title}</h2>
    <p set:html={fill(t.website.bodyHtml)} />

    <h2>{t.rights.title}</h2>
    <p set:html={fill(t.rights.bodyHtml)} />
  </Prose>
</Base>
