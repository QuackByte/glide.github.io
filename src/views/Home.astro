---
import Base from '../layouts/Base.astro';
import StripDemo from '../components/StripDemo.astro';
import Downloads from '../components/Downloads.astro';
import Parity from '../components/Parity.astro';
import { repos, github } from '../config';
import { href, messages, filler, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = messages[lang].home;
const fill = filler(lang);
---
<Base lang={lang} route="home" title={t.title} description={t.description}>
  <section class="hero">
    <div>
      <h1>{t.hero.title}</h1>
      <p class="lede">{t.hero.lede}</p>
      <div class="actions">
        <a class="button" href={href('home', lang, '#download')}>{t.hero.download}</a>
        <a class="button button--quiet" href={github(repos.mac)}>GitHub</a>
      </div>
      <p class="meta">{t.hero.meta}</p>
    </div>
    <StripDemo lang={lang} />
  </section>

  <section class="band" aria-labelledby="how">
    <h2 id="how">{t.how.title}</h2>
    <ol class="steps">
      {t.how.steps.map((step) => (
        <li>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="band" aria-labelledby="why">
    <h2 id="why">{t.keyboard.title}</h2>
    <div class="points">
      {t.keyboard.points.map((point) => (
        <div>
          <h3>{point.title}</h3>
          <p set:html={fill(point.bodyHtml)} />
        </div>
      ))}
    </div>
  </section>

  <section class="band" id="download" aria-labelledby="download-title">
    <h2 id="download-title">{t.downloadTitle}</h2>
    <Downloads lang={lang} />
  </section>

  <section class="band" id="platforms" aria-labelledby="platforms-title">
    <h2 id="platforms-title">{t.platformsTitle}</h2>
    <Parity lang={lang} />
  </section>

  <section class="band" aria-labelledby="open">
    <h2 id="open">{t.open.title}</h2>
    <div class="points">
      {t.open.points.map((point) => (
        <div>
          <h3>{point.title}</h3>
          <p set:html={fill(point.bodyHtml)} />
        </div>
      ))}
    </div>
  </section>
</Base>
