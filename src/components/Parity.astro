---
import { groups, type NotedFeatureId } from '../data/features';
import { messages, filler, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = messages[lang];
const fill = filler(lang);
---
<div class="table-scroll">
  <table class="parity">
    <caption>
      {fill(t.parity.caption)}
    </caption>
    <thead>
      <tr><th scope="col">{t.parity.feature}</th><th scope="col">Mac</th><th scope="col">Windows</th></tr>
    </thead>
    {groups.map((group) => (
      <tbody>
        <tr><th scope="rowgroup" colspan="3">{t.features.groups[group.id]}</th></tr>
        {group.features.map((f) => (
          <tr>
            <th scope="row">
              {t.features.names[f.id]}
              {'note' in f && <span class="note">{t.features.notes[f.id as NotedFeatureId]}</span>}
            </th>
            <td><span class={`status status--${f.mac}`}>{t.parity.status[f.mac]}</span></td>
            <td><span class={`status status--${f.windows}`}>{t.parity.status[f.windows]}</span></td>
          </tr>
        ))}
      </tbody>
    ))}
  </table>
</div>
