---
import { groups, type Status } from '../data/features';
import type { Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const labels: Record<Status, { en: string; es: string }> = {
  yes: { en: 'Yes', es: 'Sí' },
  partial: { en: 'Partly', es: 'En parte' },
  planned: { en: 'Planned', es: 'Previsto' },
  na: { en: 'Not needed', es: 'No aplica' },
};
---
<div class="table-scroll">
  <table class="parity">
    <caption>
      {es
        ? 'Glide para Mac y Glide para Windows comparten el mismo motor y los mismos atajos (⌃⌥ en Mac, Win en Windows). Esto es lo que hace cada una hoy.'
        : 'Glide for Mac and Glide for Windows share one engine and the same shortcuts (⌃⌥ on Mac, Win on Windows). This is what each does today.'}
    </caption>
    <thead>
      <tr><th scope="col">{es ? 'Función' : 'Feature'}</th><th scope="col">Mac</th><th scope="col">Windows</th></tr>
    </thead>
    {groups.map((group) => (
      <tbody>
        <tr><th scope="rowgroup" colspan="3">{group.name[lang]}</th></tr>
        {group.features.map((f) => (
          <tr>
            <th scope="row">
              {f.name[lang]}
              {f.note && <span class="note">{f.note[lang]}</span>}
            </th>
            <td><span class={`status status--${f.mac}`}>{labels[f.mac][lang]}</span></td>
            <td><span class={`status status--${f.windows}`}>{labels[f.windows][lang]}</span></td>
          </tr>
        ))}
      </tbody>
    ))}
  </table>
</div>
